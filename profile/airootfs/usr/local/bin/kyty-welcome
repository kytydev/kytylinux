#!/usr/bin/env bash

clear

echo " "
echo "  ✿ WELCOME TO KYTY LINUX"
echo " "
echo "  1) System information"
echo "  2) Detect graphics hardware"
echo "  3) Install Kyty desktop"
echo "  4) Install gaming packages"
echo "  5) Launch installer"
echo "  6) Exit"
echo " "

read -rp "Select an option: " choice

case "$choice" in
    1) kyty-info ;;
    2) detect-gpu ;;
    3) install-kyty-desktop ;;
    4) install-kyty-gaming ;;
    5) kyty-install ;;
    6) exit 0 ;;
    *) echo "Invalid option." ;;
esac