/* =================================
   KYTY LINUX - SAKURA GTK THEME
   ================================= */

@define-color theme_bg_color #FFFFFF;
@define-color theme_fg_color #333333;
@define-color theme_base_color #FFFFFF;
@define-color theme_text_color #333333;
@define-color theme_selected_bg_color #F4A7C5;
@define-color theme_selected_fg_color #71334F;
@define-color theme_unfocused_selected_bg_color #FAD4E3;
@define-color theme_unfocused_selected_fg_color #71334F;

/* Main windows */
window,
.background {
    background-color: #FFFFFF;
    color: #333333;
}

/* Buttons */
button {
    background-color: #FFF0F5;
    color: #71334F;
    border: 1px solid #F4A7C5;
    border-radius: 8px;
    padding: 6px 12px;
}

button:hover {
    background-color: #FAD4E3;
}

/* Selection */
selection {
    background-color: #F4A7C5;
    color: #71334F;
}

/* Entries */
entry {
    background-color: #FFFFFF;
    color: #333333;
    border: 1px solid #F4A7C5;
    border-radius: 6px;
}

/* Progress bars */
progressbar progress {
    background-color: #F4A7C5;
}