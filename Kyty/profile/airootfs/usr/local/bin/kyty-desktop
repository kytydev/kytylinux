#!/usr/bin/env bash

set -e

echo ""
echo "  ✿ KYTY LINUX — SAKURA DESKTOP"
echo ""

if ! command -v startx >/dev/null 2>&1; then
    echo "XFCE is not installed."
    echo "Install the optional Kyty desktop first."
    exit 1
fi

if ! command -v xfce4-session >/dev/null 2>&1; then
    echo "XFCE session was not found."
    exit 1
fi

echo "Starting Kyty Sakura Desktop..."

exec startx /usr/bin/xfce4-session